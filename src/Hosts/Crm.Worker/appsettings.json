{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Crm": ""
  },
  "Redis": {
    "Configuration": ""
  },
  "Kafka": {
    "BootstrapServers": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8081"
      }
    }
  },
  "AllowedHosts": "*"
}
