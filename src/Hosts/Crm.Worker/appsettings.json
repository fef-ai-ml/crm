{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Crm": ""
  },
  "Redis": {
    "Configuration": ""
  },
  "Kafka": {
    "BootstrapServers": ""
  },
  "Profiles": {
    "Consumer": {
      "Enabled": true,
      "Instances": 4
    }
  },
  "Segmentation": {
    "Run": {
      "CommandTimeoutSeconds": 300,
      "PollInterval": "00:00:05"
    },
    "Schedule": {
      "Interval": "06:00:00"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8081"
      }
    }
  },
  "AllowedHosts": "*"
}
