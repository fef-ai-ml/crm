# Copied to deploy/.env by `make up` when absent. Local development values only.
MSSQL_SA_PASSWORD=Crm_Dev_Passw0rd!
# SQL engine image. CI and amd64 engines (including a remote home-lab box): mcr.microsoft.com/mssql/server:2022-latest
# arm64 hosts without Rosetta (Podman libkrun): use mcr.microsoft.com/azure-sql-edge:latest instead.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# Engine-side host port for SQL Server (container always listens on 1433). Change when the engine
# already runs a SQL Server on 1433; `make tunnel` maps it back to localhost:1433 for the apps.
MSSQL_HOST_PORT=1433
# Remote engines only: hostname Testcontainers should connect to for mapped ports (empty = local engine).
TESTCONTAINERS_HOST_OVERRIDE=
# Host port for Redis (container always listens on 6379). Change if 6380 is taken.
REDIS_HOST_PORT=6380
# HS256 signing key for development JWTs (>= 32 bytes). Replaced by RS256 keys outside local dev.
AUTH_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef
# Observability profile (`make up-observability`). Host-side ports; Grafana avoids 3000 (web).
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
JAEGER_HOST_PORT=16686
# Grafana admin password (anonymous Viewer access is enabled for local development).
GRAFANA_ADMIN_PASSWORD=admin
# Image builds: set to 1 when the engine host resolves nuget.org to IPv6 but cannot route it
# (`dotnet restore` fails with NU1301 timeouts during `make up`). Default 0.
DOTNET_SYSTEM_NET_DISABLEIPV6=0
