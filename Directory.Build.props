<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Must be true: EnforceCodeStyleInBuild + IDE0005=warning below require it to run at build time
         (https://github.com/dotnet/roslyn/issues/41640); otherwise every project fails with
         "EnableGenerateDocumentationFile" instead of actually checking unnecessary usings. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Analyzer rules that add noise without value for this codebase; every other recommended rule is an error. -->
    <NoWarn>$(NoWarn);CA1848;CA2007;CA1515;CA1303;CA1031;CA1812;CA1054;CA1056;CA2234;CA1861;CA1062;CA5394</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA2000;CA1063;CA1816;CA1001</NoWarn>
  </PropertyGroup>
</Project>
